# Copy to .env (never commit .env) and fill in. On Vercel, add the same
# variables under Project -> Settings -> Environment Variables instead.

# --- Required ---------------------------------------------------------------
# PostgreSQL connection string (Supabase, Neon, Vercel Postgres, local, ...).
# On serverless hosts use the provider's *pooled* connection string.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE
# true for managed/hosted Postgres, false for a local database.
DATABASE_SSL=false
# Secret used to sign admin sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Recommended ------------------------------------------------------------
# Public address of the site (no trailing slash). Used for sitemap.xml,
# canonical URLs and link previews.
SITE_URL=http://localhost:3000

# --- Image storage ----------------------------------------------------------
# local = files on the server's disk (development / VPS).
# s3    = any S3-compatible bucket (Supabase Storage, Cloudflare R2, AWS S3).
#         Required on Vercel, whose filesystem is read-only.
STORAGE_DRIVER=local
# UPLOAD_DIR=uploads
# S3_ENDPOINT=
# S3_REGION=auto
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Public base URL the bucket's objects are served from (no trailing slash).
# S3_PUBLIC_URL=
# S3_FORCE_PATH_STYLE=true

# --- Optional ---------------------------------------------------------------
# API_PORT=4000
# SESSION_HOURS=12
# UPLOAD_MAX_MB=8
# MAX_IMAGES_PER_VEHICLE=30
# DATABASE_POOL_MAX=5
# Only if the frontend is served from a different origin than the API:
# CORS_ORIGINS=https://www.example.com
# COOKIE_SAMESITE=none
